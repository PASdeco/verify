# VERIFY — environment template.
# Copy to .env (repo root, next to contracts/) and fill in.
# NEVER commit the real .env.
# NOTE: every wallet address / private key used in this project must be
# personally confirmed by the owner before being placed here.

# ---- GenLayer connection -------------------------------------------------
# Network for contract deployment + backend-funded execution:
# studionet | testnet_asimov | testnet_bradbury | localnet
GENLAYER_NETWORK=studionet
GENLAYER_RPC=

# Backend-funded relayer wallet that submits verifications (server-side ONLY).
# Generate a dedicated wallet; never reuse a personal one. Requires funds.
RELAYER_PRIVATE_KEY=

# ---- Deployed contract (filled after deployment) --------------------------
GENLAYER_CONTRACT_ADDRESS=

# ---- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Mode ----------------------------------------------------------------
# REAL_STUDIONET = use the deployed contract via the backend relayer
# DEVELOPMENT_DEMO = simulated results, clearly labelled in the UI
VERIFY_MODE=DEVELOPMENT_DEMO
